<h2>Chat</h2>

<div id="messages">
  <% @messages.each do |message| %>
    <p><strong><%= message.user %>:</strong> <%= message.content %></p>
  <% end %>
</div>

<form id="new_message">
  <input type="text" id="message_content" placeholder="Type your message..." />
  <input type="hidden" id="user_name" value="">
  <button>Send</button>
</form>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const chatChannel = consumer.subscriptions.subscriptions.find((sub) => sub.identifier.includes("ChatChannel"));

    document.getElementById("new_message").addEventListener("submit", (event) => {
      event.preventDefault();
      const messageInput = document.getElementById("message_content");
      const userName = document.getElementById("user_name");

      chatChannel.speak(messageInput.value, userName.value);
      messageInput.value = "";
    });
  });
</script>
