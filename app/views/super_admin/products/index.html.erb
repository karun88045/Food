<%= render "shared/menubar" %>

<div class="px-md-3 py-md-4 px-2 py-3">
  <div class="card">
    <div class="card-header p-md-4 p-3 d-flex justify-content-between align-items-center flex-wrap">
      <div class="card-heading fs-5">Products</div>
      <div class="d-flex">
        <div class="btn btn-primary py-2 px-sm-3 px-2">
          <%= link_to "New Product", new_super_admin_product_path, class: "text-decoration-none text-white fs-6" %>
        </div>
      </div>
    </div>
    <div class="card-body table-responsive p-md-3 p-2">
      <table class="table table-hover mt-2">
        <thead class="light-purple-table-header ">
          <tr class="fs-6">
            <th>Name</th>
            <th>Size</th>
            <th>Price</th>
            <th>Discounted Price</th>
            <th>Activate/Deactivate</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <tr class="fs-6">
              <td><%= product.name %></td>
              <td><%= product.size %></td>
              <td><%= product.price %></td>
              <td><%= product.discounted_price %></td>
              <td>
                <div class="text-center">
                  <% if product.deactivated_at %>
                    <span class="del">
                      <%= link_to "", activate_super_admin_product_path(product), method: :put, class: "fas fa-toggle-off fs-4 edit-icon-green", title: 'Activate' %>
                    </span>
                  <% else %>
                    <span class="del">
                      <%= link_to "", deactivate_super_admin_product_path(product), method: :put, class: "fas fa-toggle-on fs-4  edit-icon-green", title: 'Deactivate' %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="link text-end">
                <%= link_to "", edit_super_admin_product_path(product), class: "fas fa-edit text-success me-2" %>
                <span class="del">
                  <%= link_to "", super_admin_product_path(product), class: "fa-solid fa-trash-can delete-icon-red", method: :delete, data: { confirm: "You sure?" } %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>
    <%# render "shared/pagy" %>
  </div>
</div>
