<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<%= render "shared/menubar" %>
<div class="container">
  <div class="px-sm-4 px-3">
    <div class="row mt-3">
      <div class="col-md-4 offset-md-8">

      </div>
    </div>
    <div class="dashboard-cards">
      <div class="row info-cards mt-4" >
        <%= stats_box(2, "Users", "users") %>
        <%= stats_box(2, "Users", "users") %>
        <%= stats_box(2, "Users", "users") %>
        <%= stats_box(2, "Users", "users") %>
        <%= stats_box(2, "Users", "users") %>
        <%= stats_box(2, "Users", "users") %>
        <%= stats_box(2, "Users", "users") %>
        <%= stats_box(2, "Users", "users") %>
      </div>
    </div>

    <div class="pt-lg-5 pt-4">
      <div class="col-lg-12 graph-card">
        <div class="card p-3 h-100 border-0">
          <div class="fs-4 mx-3 text-dark-shade"></div>
          <div class="card-body p-3">
            <div
              class="w-100 row align-items-center justify-content-center"
              id="trend-chart"
              style="height: 350px"
            ></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<style>
.dashboard-cards {
  border-bottom: 1px solid #fff;
}

.info-cards {
  display: grid;
  justify-content: center;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  margin-bottom: 30px;
  gap: 20px;
}
</style>